# 텍스트/Guardrail 호출용 SSAFY GMS 설정
GMS_KEY=your_gms_key_here
GMS_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# 이미지 생성: 아래 둘 중 프로젝트에서 실제 제공하는 방식 하나를 설정하세요.
# A) Google Gemini API 직접 호출 (Google AI Studio에서 발급한 Gemini API Key 필요)
GEMINI_API_KEY=your_gms_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# B) SSAFY GMS가 Gemini GenerateContent 네이티브 프록시를 제공하는 경우
# GMS 문서에 안내된 실제 Base URL을 /v1beta까지 포함해 입력하고, GMS_KEY를 인증에 사용합니다.
# 설정하면 A보다 B가 우선 적용됩니다.
GMS_GEMINI_BASE_URL=your_gms_key_here
